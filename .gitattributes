# Всё, что выполняется или читается на Linux при сборке/установке, — только LF,
# независимо от core.autocrlf на машине разработчика. Остальные файлы git не трогает.
*.sh                        text eol=lf
scripts/**                  text eol=lf
packaging/linux/**          text eol=lf
packaging/android/**        text eol=lf
packaging/common/panel/*.ini text eol=lf
packaging/common/panel/i18n.* text eol=lf
.nvmrc                      text eol=lf
CHANGELOG.md                text eol=lf

# Windows-файлы
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.nsi  text eol=lf
*.nsh  text eol=lf

# Бинарные файлы — без преобразований
*.jar  binary
*.dll  binary
*.exe  binary
*.sys  binary
*.cat  binary
*.so   binary
*.ico  binary
*.png  binary
*.hex  -text

# Файлы, в которые scripts/sync-version.sh пишет версию
desktop/package.json        text eol=lf
desktop/version             text eol=lf
desktop/home.html           text eol=lf

# Драйверы Windows (копия из RS3_Assembly) — как есть: .inf/.cat подписаны, менять байты нельзя
packaging/common/drivers/** -text -eol
